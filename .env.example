# Copy to .env and fill in. .env is gitignored — never commit real values.

# The email address of your Atlassian account.
ATLASSIAN_EMAIL=you@company.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Create it with ONLY the read scopes: read:jira-work, read:jira-user.
ATLASSIAN_API_TOKEN=your_token

# Your Jira site, e.g. https://your-company.atlassian.net
ATLASSIAN_SITE_URL=https://your-company.atlassian.net

# Almost never needed: the server detects the correct base URL automatically
# (scoped tokens require https://api.atlassian.com/ex/jira/{cloudId}).
# Set this only if startup logs say cloud-ID detection failed.
#ATLASSIAN_CLOUD_ID=
